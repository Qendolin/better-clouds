{
  "schemaVersion": 1,
  "id": "betterclouds",
  "version": "${version}",
  "name": "Better Clouds",
  "description": "Beautiful clouds in touch with the vanilla style.",
  "authors": [
    "Qendolin"
  ],
  "contact": {
    "homepage": "https://github.com/Qendolin/better-clouds",
    "sources": "https://github.com/Qendolin/better-clouds",
    "issues": "https://github.com/Qendolin/better-clouds/issues/new"
  },
  "license": "MPL-2.0",
  "icon": "assets/betterclouds/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.qendolin.betterclouds.Entrypoint"
    ],
    "modmenu": [
      "com.qendolin.betterclouds.ModMenuIntegration"
    ],
    "preLaunch": [
      "com.qendolin.betterclouds.platform.fabric.Crash_Is_Not_Caused_By_BetterClouds"
    ]
  },
  "mixins": [
    "betterclouds.required.mixins.json",
    "betterclouds.optional.mixins.json",
    "betterclouds.runtime.mixins.json"
  ],
  "accessWidener": "betterclouds.accesswidener",
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": [
      $mc_version_range
    ],
    "java": ">=17",
    "fabric-api": "*",
    "yet_another_config_lib_v3": "^3.6.0"
  },
  "recommends": {
    "modmenu": "*",
    "sodium": "*"
  },
  "breaks": {
    "vulkanmod": "*",
    "iris": "<1.7.0",
    "immersive_portals": "*"
  }
}
